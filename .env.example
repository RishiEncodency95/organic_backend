PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/organic_db
JWT_SECRET=your_jwt_secret_here
SITE_URL=https://bharatorganicexpo.com/

# Backend Auth
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRE=7d
COOKIE_SECRET=your_cookie_secret_here
TOTP_APP_NAME=OrganicAdmin
ALLOWED_ORIGIN=http://localhost:3001

# Redis
REDIS_URL=redis://localhost:6379
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_OTP=otpAuthentication

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@bharatorganicexpo.com
FROM_NAME="Bharat Organic Expo"

# WhatsApp Configuration (Opus)
OPUS_API_KEY=your_opus_api_key_here
ADMIN_WHATSAPP_NUMBER=your_whatsapp_number_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Notification Settings (Where to receive inquiries)

# Contact Form Dedicated SMTP (Optional)
CONTACT_ADMIN_EMAIL=your_contact_admin_email@gmail.com
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=your_email@gmail.com
CONTACT_SMTP_PASS=your_app_password
CONTACT_FROM_EMAIL=your_email@gmail.com
CONTACT_FROM_NAME="IHWE Contact Desk"

# Speaker Registration Dedicated SMTP (Optional)
SPEAKER_ADMIN_EMAIL=your_speaker_admin_email@gmail.com
SPEAKER_SMTP_HOST=smtp.gmail.com
SPEAKER_SMTP_PORT=587
SPEAKER_SMTP_USER=your_email@gmail.com
SPEAKER_SMTP_PASS=your_app_password
SPEAKER_FROM_EMAIL=your_email@gmail.com
SPEAKER_FROM_NAME="IHWE Speaker Portal"

# Visitor Registration Dedicated SMTP
VISITOR_ADMIN_EMAIL=your_visitor_admin_email@gmail.com
VISITOR_SMTP_HOST=smtp.gmail.com
VISITOR_SMTP_PORT=587
VISITOR_SMTP_USER=your_email@gmail.com
VISITOR_SMTP_PASS=your_app_password
VISITOR_FROM_EMAIL=your_email@gmail.com
VISITOR_FROM_NAME="IHWE Visitor Portal"

# Exhibitor Registration Dedicated SMTP
EXHIBITOR_ADMIN_EMAIL=your_exhibitor_admin_email@gmail.com
EXHIBITOR_SMTP_HOST=smtp.gmail.com
EXHIBITOR_SMTP_PORT=587
EXHIBITOR_SMTP_USER=your_email@gmail.com
EXHIBITOR_SMTP_PASS=your_app_password
EXHIBITOR_FROM_EMAIL=your_email@gmail.com
EXHIBITOR_FROM_NAME="IHWE Exhibitor Portal"

BUYER_ADMIN_EMAIL=your_buyer_admin_email@gmail.com
OPENAI_API_KEY=your_openai_api_key_here

# Website chatbot (Organic Mitra)
OPENAI_MODEL=gpt-5.4-mini
# Browser origins allowed to call /api/chat (comma-separated)
ALLOWED_ORIGINS=http://localhost:3002,https://bharatorganicexpo.com,https://www.bharatorganicexpo.com
# AiSensy campaigns sent after the chat's WhatsApp OTP is verified: details to the visitor
# ({{1}} name, {{2}} mobile, {{3}} enquiry) and an enquiry copy to ADMIN_WHATSAPP_NUMBER
# ({{1}} name, {{2}} mobile, {{3}} enquiry, {{4}} page). Leave empty to skip that WhatsApp.
AISENSY_CAMPAIGN_CHAT_USER=
AISENSY_CAMPAIGN_CHAT_ADMIN=

# Shared Credentials
GEMINI_API_KEY=your_gemini_api_key_here
PAGESPEED_API_KEY=your_pagespeed_api_key_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# URLs
FRONTEND_URL=http://localhost:3002
ADMIN_URL=http://localhost:3000

# Website cache refresh after admin saves (must match frontend REVALIDATE_SECRET)
REVALIDATE_SECRET=change-me

# Infrastructure (Servers & Domains) module - opt-in
INFRASTRUCTURE_ENABLED=false
# base64 of 32 random bytes, UNIQUE to this deployment: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
# Optional tuning (defaults shown)
# INFRA_SWEEP_MINUTES=30
# INFRA_RDAP_INTERVAL_HOURS=24
# INFRA_DNS_INTERVAL_HOURS=6
# INFRA_SSL_INTERVAL_HOURS=24
# INFRA_PROVIDER_SYNC_MINUTES=360
# INFRA_DNS_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9
# INFRA_DEFAULT_CURRENCY=INR
# INFRA_EMAIL_DISABLED=true
# INFRA_SCHEDULER=off
